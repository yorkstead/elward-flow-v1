{
  "name": "elward-flow-v1",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:cf": "opennextjs-cloudflare build",
    "deploy:cf": "opennextjs-cloudflare build && wrangler deploy",
    "preview": "next dev",
    "start": "next start",
    "setup": "docker compose up -d --wait && bun run db:migrate && bun run seed",
    "deps:up": "docker compose up -d",
    "deps:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "seed": "bun scripts/seed.ts",
    "seed:showcase": "bun scripts/seed-showcase-release.ts",
    "generate:demo-files": "bun scripts/generate-demo-release-files.ts",
    "db:reset-releases": "bun scripts/reset-releases-and-seed-inventory.ts",
    "admin:create": "bun scripts/create-admin.ts",
    "worker": "bun worker/index.ts",
    "worker:smoke": "bun scripts/enqueue-worker-smoke.ts",
    "storage:cors": "bun scripts/configure-storage-cors.ts",
    "storage:verify-direct-upload": "bun scripts/verify-direct-upload.ts",
    "env:verify": "bun scripts/verify-environment.ts",
    "backup": "bun scripts/backup.ts",
    "restore:verify": "bun scripts/verify-restore.ts",
    "test": "vitest run tests/unit",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:all": "bun run format:check && bun run lint && bun run typecheck && bun audit --production && bun run test:unit && bun run test:integration && bun run build && bun run test:e2e",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1116.0",
    "@aws-sdk/lib-storage": "3.1116.0",
    "@aws-sdk/s3-request-presigner": "3.1116.0",
    "@base-ui/react": "^1.7.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "jszip": "^3.10.1",
    "lucide-react": "^1.31.0",
    "next": "^16.3.2",
    "next-auth": "^5.0.0-beta.32",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0",
    "pg-cloudflare": "^1.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.18.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@opennextjs/cloudflare": "^1.20.4",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/jszip": "^3.4.1",
    "@types/node": "^20",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "3.2.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "^16.3.2",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "3.2.4",
    "wrangler": "^4.127.1"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
