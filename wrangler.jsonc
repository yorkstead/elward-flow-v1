{
  "$schema": "node_modules/wrangler/config-schema.json",
 // wrangler.jsonc
vv"name": "yorkstead-operations-proxy",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
