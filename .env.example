# Copy to .env.local. Replace every CHANGE_ME value before use.
NODE_ENV=development
APP_URL=http://localhost:3000
AUTH_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_32
DATABASE_URL=postgresql://elward:elward_local_only@localhost:5432/elward_flow
POSTGRES_DB=elward_flow
POSTGRES_USER=elward
POSTGRES_PASSWORD=elward_local_only
POSTGRES_PORT=5432
MINIO_ENDPOINT=http://localhost:9000
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=elward-local
MINIO_SECRET_KEY=elward-local-password
MINIO_BUCKET=elward-flow-local
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=elward-local
MINIO_ROOT_PASSWORD=elward-local-password
ADMIN_EMAIL=admin@example.test
WORKER_POLL_INTERVAL_MS=1000
LOG_LEVEL=info
