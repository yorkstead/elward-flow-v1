# Application
NODE_ENV="development"
APP_URL="http://localhost:3000"

# Authentication (required; generate with: openssl rand -base64 32)
AUTH_SECRET=""

# Database
DATABASE_URL="postgresql://elward:elward_local_only@localhost:5432/elward_flow"

# FileStore Object Storage (MinIO / S3)
MINIO_ENDPOINT="http://localhost:9000"
MINIO_REGION="us-east-1"
MINIO_ACCESS_KEY="elward-local"
MINIO_SECRET_KEY="elward-local-password"
MINIO_BUCKET="elward-flow-local"

# Admin & Operational Defaults
ADMIN_EMAIL="admin@example.test"
WORKER_POLL_INTERVAL_MS=1000
LOG_LEVEL="info"

# Set E2E_ADMIN_PASSWORD temporarily in your shell to the one-time password
# printed by `bun run seed`; never store it in this file.
